POSTGRES_URL=postgresql+asyncpg://postgres:password@postgres:5432/refinery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER=redis://redis:6379/0
GCP_PROJECT=my-gcp-project
VERTEX_LOCATION=europe-west4
SLACK_SIGNING_SECRET=mock-signing-secret-phase1
CRM_WEBHOOK_SECRET_HUBSPOT=mock-hubspot-secret
CRM_WEBHOOK_SECRET_SALESFORCE=mock-salesforce-secret
MOCK_SURFACES=true
KAIDE_LABS_PROJECT_ID=kaide-labs-project
KAIDE_LABS_REGION=europe-west4

# ─── Phase 1.7 — External enrichment APIs ─────────────────────────────
# Companies House (UK Public Data API): https://developer.company-information.service.gov.uk/
COMPANIES_HOUSE_API_KEY=your_companies_house_api_key_here
# Tavily (AI-agent-optimized web search): https://docs.tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# ─── Phase 1.7 — Web scraping ──────────────────────────────────────────
PLAYWRIGHT_TIMEOUT_MS=8000

# ─── Phase 1.7 — Cloud Logging ─────────────────────────────────────────
# K_SERVICE auto-set by Cloud Run triggers JSON output; this is a local override
GCP_LOGGING_ENABLED=false
GCP_PROJECT_LOG_NAME=matta-refinery

# ─── Phase 1.7 — Enrichment behavior ───────────────────────────────────
ENRICHMENT_USE_CACHE=true
ENRICHMENT_CACHE_TTL_HOURS=168
